## ─── Core LLM ───────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_JOB_AGENT_MODEL=gpt-4.1-mini
OPENAI_OUTREACH_MODEL=gpt-4.1-mini

## ─── Job Search — Apify ──────────────────────────────────────────────────────
APIFY_API_TOKEN=

# US market actor overrides (defaults shown)
