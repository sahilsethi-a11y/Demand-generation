## ─── Apollo (ICP enrichment only — NOT used for job search) ─────────────────
APOLLO_API_KEY=

## ─── Instantly (outbound lead delivery) ─────────────────────────────────────
INSTANTLY_API_KEY=
INSTANTLY_CAMPAIGN_ID=

## ─── Search ──────────────────────────────────────────────────────────────────
TAVILY_API_KEY=

